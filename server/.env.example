# Copy to .env and adjust. All values have sensible defaults for local dev.

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWT session tokens. Change this in production.
JWT_SECRET=fable-and-ink-dev-secret-change-me

# MongoDB connection string.
# Leave UNSET to auto-start an in-memory MongoDB (mongodb-memory-server) — great
# for local dev and demos, no install required. Set it to a real cluster/URI in
# production, e.g. mongodb://localhost:27017/fable-ink or a mongodb+srv://... URI.
# MONGO_URI=mongodb://localhost:27017/fable-ink

# When true (default), the database is (re)seeded with demo content on boot if
# it looks empty. Set to "false" to skip seeding.
SEED_ON_BOOT=true
